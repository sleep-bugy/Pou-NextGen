{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pou-nextgen",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/multiplayer", "/api/health"]
  },
  "durable_objects": { "bindings": [{ "name": "POU_HUB", "class_name": "PouHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PouHub"] }]
}
